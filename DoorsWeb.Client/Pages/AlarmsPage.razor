@page "/alarms"
@using DoorsWeb.Client.Services
@implements IDisposable
@inject IHttpClientFactory ClientFactory
@inject DoorStatusStore DoorStatus
@inject AuthenticationStateProvider AuthState
@inject TabBlazor.Services.IModalService ModalService

<Card>
    <CardHeader>
        <CardTitle>
            <Icon class="icon me-2" IconType="@TablerIcons.Alert_triangle" />Alarms
        </CardTitle>
        <CardActions class="ms-auto">
            <Button BackgroundColor="TablerColor.Primary" OnClick="Refresh">
                <Icon class="icon me-1" IconType="@TablerIcons.Refresh" />Refresh
            </Button>
        </CardActions>
    </CardHeader>
    <CardBody>
        @if (!IsLoaded)
        {
            <Progress Color="TablerColor.Blue" Indeterminate />
        }

        <Tabs>
            <Tab Title="Active">
                <Table Item="AlarmListDto" Items="ActiveAlarms" PageSize="10" Hover Responsive>
                    <ChildContent>
                        <Column Item="AlarmListDto" Property="a => a.Description" Title="Description" Searchable Sortable />
                        <Column Item="AlarmListDto" Property="a => a.Location" Title="Location" Searchable Sortable />
                        <Column Item="AlarmListDto" Property="a => a.Date" Title="Date" Sortable />
                        @if (CanAction)
                        {
                            <Column Item="AlarmListDto" title="" ActionColumn Width="120px">
                                <Template>
                                    <Button Size="ButtonSize.Small" BackgroundColor="TablerColor.Primary"
                                            OnClick="() => ActionAlarm(context)">
                                        <Icon class="icon me-1" IconType="@TablerIcons.Check" />Action
                                    </Button>
                                </Template>
                            </Column>
                        }
                    </ChildContent>
                </Table>
                @if (IsLoaded && ActiveAlarms.Count == 0)
                {
                    <div class="text-muted text-center py-4">No active alarms found.</div>
                }
            </Tab>

            <Tab Title="Actioned">
                <Table Item="AlarmListDto" Items="ActionedAlarms" PageSize="10" Hover Responsive>
                    <ChildContent>
                        <Column Item="AlarmListDto" Property="a => a.Description" Title="Description" Searchable Sortable />
                        <Column Item="AlarmListDto" Property="a => a.Location" Title="Location" Searchable Sortable />
                        <Column Item="AlarmListDto" Property="a => a.Date" Title="Date" Sortable />
                        <Column Item="AlarmListDto" Property="a => a.Details" Title="Details" Searchable Sortable />
                        <Column Item="AlarmListDto" Property="a => a.ActionedBy" Title="Actioned By" Searchable Sortable />
                        <Column Item="AlarmListDto" Property="a => a.Turnaround" Title="Turnaround" Sortable />
                    </ChildContent>
                </Table>
                @if (IsLoaded && ActionedAlarms.Count == 0)
                {
                    <div class="text-muted text-center py-4">No actioned alarms found.</div>
                }
            </Tab>
        </Tabs>
    </CardBody>
</Card>

@code {
    private bool IsLoaded = false;
    private bool CanAction = false;
    private HttpClient client = new HttpClient();
    private List<AlarmListDto> ActiveAlarms = new();
    private List<AlarmListDto> ActionedAlarms = new();

    protected override async Task OnInitializedAsync()
    {
        client = ClientFactory.CreateClient("WebAPI");

        var authState = await AuthState.GetAuthenticationStateAsync();
        CanAction = authState.User.CanWriteSiteSettings();

        // Live-refresh when the server logs or actions an alarm. Uses the app-wide status store's
        // connection (best-effort: if it isn't connected, the Refresh button still works).
        DoorStatus.AlarmsChanged += OnAlarmsChanged;
        await DoorStatus.EnsureStartedAsync();

        await Refresh();
    }

    private async Task Refresh()
    {
        IsLoaded = false;
        var alarms = await client.GetFromJsonAsync<List<AlarmListDto>>("api/Alarm") ?? [];
        ActiveAlarms = alarms.Where(a => !a.IsActioned).ToList();
        ActionedAlarms = alarms.Where(a => a.IsActioned).ToList();
        IsLoaded = true;
        StateHasChanged();
    }

    private async Task ActionAlarm(AlarmListDto alarm)
    {
        var component = new RenderComponent<AlarmActionModal>().Set(m => m.Description, alarm.Description);
        var result = await ModalService.ShowAsync("Action Alarm", component, new ModalOptions
        {
            Size = ModalSize.Large,
            ShowHeader = true,
            Scrollable = false,
        });
        if (result.Cancelled) return;

        var note = result.Data as string;
        try
        {
            var response = await client.PostAsJsonAsync($"api/Alarm/{alarm.Code}/action",
                new AlarmActionRequest { Note = note });
            if (!response.IsSuccessStatusCode)
            {
                await ModalService.ShowDialogAsync(new TabBlazor.Components.Modals.DialogOptions
                {
                    MainText = "Could not action the alarm.",
                    SubText = response.StatusCode.ToString(),
                    IconType = TablerIcons.Alert_triangle,
                    CancelText = "",
                    StatusColor = TablerColor.Danger
                });
            }
        }
        catch
        {
            // Network hiccup — leave the row in place; a Refresh reconciles.
        }

        await Refresh();
    }

    private void OnAlarmsChanged() => _ = InvokeAsync(Refresh);

    public void Dispose() => DoorStatus.AlarmsChanged -= OnAlarmsChanged;
}
