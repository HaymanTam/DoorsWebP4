@using DoorsWeb.Client.Services
@using DoorsWeb.Shared.Enums
@implements IDisposable
@inject DoorStatusStore DoorStatus
@inject AuthenticationStateProvider AuthState

<TablerForm Model="@dDetail" OnValidSubmit="Submit" >
    <Tabs>
        @* ============================= GENERAL ============================= *@
        <Tab Title="General">
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Controller</CardTitle>
                    <div class="mb-3">
                        <label class="form-label">Door Name</label>
                        <InputText class="form-control" @bind-Value="dDetail.Name"></InputText>
                        <TabValidationMessage For="(() => dDetail.Name)"></TabValidationMessage>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Controller Address</label>
                        <InputNumber class="form-control" @bind-Value="dDetail.ControllerId"></InputNumber>
                        <TabValidationMessage For="(() => dDetail.ControllerId)"></TabValidationMessage>
                    </div>
                </CardBody>
            </Card>

            <div class="row">
                <div class="col-lg-7">
                    <Card Size="CardSize.Default">
                        <CardBody>
                            <div class="mb-3">
                                <label class="form-label">IP Address</label>
                                <InputText class="form-control" @bind-Value="dDetail.IPAddressString"></InputText>
                                <TabValidationMessage For="(() => dDetail.IPAddressString)"></TabValidationMessage>
                            </div>
                        </CardBody>
                    </Card>
                </div>
                <div class="col-lg-5">
                    <Card Size="CardSize.Default">
                        <CardBody>
                            <div class="mb-3">
                                <label class="form-label">Random Search Frequency</label>
                                <InputNumber class="form-control" @bind-Value="dDetail.RandomSearchFrequency"></InputNumber>
                            </div>
                        </CardBody>
                    </Card>
                </div>
            </div>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Sound</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Feedback</label>
                            <span class="d-flex my-auto gap-2">
                                <Icon IconType="@TablerIcons.Volume" />
                                <RangeSlider TValue="byte" @bind-Value="dDetail.Controller_FeedbackVolume" Min="0" Max="15" />
                                <label class="form-label">@dDetail.Controller_FeedbackVolume</label>
                            </span>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Alarm</label>
                            <span class="d-flex my-auto gap-2">
                                <Icon IconType="@TablerIcons.Volume" />
                                <RangeSlider TValue="byte" @bind-Value="dDetail.Controller_AlarmVolume" Min="0" Max="15" />
                                <label class="form-label">@dDetail.Controller_AlarmVolume</label>
                            </span>
                        </div>
                    </div>
                </CardBody>
            </Card>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Notes</CardTitle>
                    <div class="mb-3">
                        <InputTextArea class="form-control" @bind-Value="dDetail.Notes"></InputTextArea>
                        <TabValidationMessage For="(() => dDetail.Notes)"></TabValidationMessage>
                    </div>
                </CardBody>
            </Card>

            <div class="mb-3 row">
                <div class="col-lg-6">
                    <label class="form-label">Valid From Time</label>
                    <Input type="time" class="form-control" @bind-Value="dDetail.ValidFrom"></Input>
                    <TabValidationMessage For="(() => dDetail.ValidFrom)"></TabValidationMessage>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">Valid To Time</label>
                    <Input type="time" class="form-control" @bind-Value="dDetail.ValidTo"></Input>
                    <TabValidationMessage For="(() => dDetail.ValidTo)"></TabValidationMessage>
                </div>
            </div>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Statistics</CardTitle>
                    <div class="d-flex justify-content-between">
                        <span>Date: <strong>Unknown</strong></span>
                        <span>Firmware version: <strong>Unknown</strong></span>
                    </div>
                </CardBody>
            </Card>
        </Tab>

        @* ============================= READERS ============================= *@
        <Tab Title="Readers">
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Reader A</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="dDetail.ReaderA_Name"></InputText>
                            <TabValidationMessage For="(() => dDetail.ReaderA_Name)"></TabValidationMessage>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Technology</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.ReaderA_TechId">
                                @foreach (var t in ReaderTechnologies)
                                {
                                    <option value="@t.Key">@t.Value</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-lg-6 ">
                            <label class="form-label">Volume</label>
                            <span class="d-flex my-auto gap-2">
                                <Icon IconType="@TablerIcons.Volume" />
                                <RangeSlider TValue="byte" @bind-Value="dDetail.ReaderA_Volume" Min="0" Max="15"  />
                                <label class="form-label">   @dDetail.ReaderA_Volume</label>
                            </span>
                            <TabValidationMessage For="(() => dDetail.ReaderA_Volume)"></TabValidationMessage>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Brightness</label>
                            <span class="d-flex my-auto gap-2">
                                <Icon IconType="@TablerIcons.Brightness_up" />
                                <RangeSlider TValue="byte" @bind-Value="dDetail.ReaderA_Brightness" Min="0" Max="9" />
                                <label class="form-label">   @dDetail.ReaderA_Brightness</label>
                            </span>
                            <TabValidationMessage For="(() => dDetail.ReaderA_Brightness)"></TabValidationMessage>
                        </div>
                    </div>
                </CardBody>
            </Card>
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Reader B</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="dDetail.ReaderB_Name"></InputText>
                            <TabValidationMessage For="(() => dDetail.ReaderB_Name)"></TabValidationMessage>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Technology</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.ReaderB_TechId">
                                @foreach (var t in ReaderTechnologies)
                                {
                                    <option value="@t.Key">@t.Value</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-lg-6 ">
                            <label class="form-label">Volume</label>
                            <span class="d-flex my-auto gap-2">
                                <Icon IconType="@TablerIcons.Volume" />
                                <RangeSlider TValue="byte" @bind-Value="dDetail.ReaderB_Volume" Min="0" Max="15" />
                                <label class="form-label">   @dDetail.ReaderB_Volume</label>
                            </span>
                            <TabValidationMessage For="(() => dDetail.ReaderB_Volume)"></TabValidationMessage>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Brightness</label>
                            <span class="d-flex my-auto gap-2">
                                <Icon IconType="@TablerIcons.Brightness_up" />
                                <RangeSlider TValue="byte" @bind-Value="dDetail.ReaderB_Brightness" Min="0" Max="9" />
                                <label class="form-label">   @dDetail.ReaderB_Brightness</label>
                            </span>
                            <TabValidationMessage For="(() => dDetail.ReaderB_Brightness)"></TabValidationMessage>
                        </div>
                    </div>
                </CardBody>
            </Card>
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Keypad</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Text Description</label>
                            <InputText class="form-control" @bind-Value="dDetail.Keypad_Name"></InputText>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Technology</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.Keypad_TechId">
                                @foreach (var t in KeypadTechnologies)
                                {
                                    <option value="@t.Key">@t.Value</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3 row align-items-end">
                        <div class="col-lg-6">
                            <label class="form-label">Access Code</label>
                            <InputNumber class="form-control" @bind-Value="dDetail.Keypad_AccessCode"></InputNumber>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="dDetail.Keypad_StarModeEnable"></InputCheckbox>
                                <span class="form-check-label">Enable * Key</span>
                            </label>
                        </div>
                    </div>
                </CardBody>
            </Card>
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Multi Factor Authentication</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-4">
                            <label class="form-label">ID Sequence Reader A</label>
                            <input type="number" class="form-control" @bind="dDetail.ReaderA_MFA_Sequence" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">ID Sequence Reader B</label>
                            <input type="number" class="form-control" @bind="dDetail.ReaderB_MFA_Sequence" />
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label">Override Time zone</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.MFA_OverrideTimeZone">
                                <option value=""></option>
                            </InputSelect>
                            <small class="text-muted">(Single factor during this time)</small>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </Tab>

        @* ============================= OUTPUTS ============================= *@
        <Tab Title="Outputs">
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Lock</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Delay release by (seconds)</label>
                            <input type="number" class="form-control" @bind="dDetail.RelayA_Delay" />
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Drive Mode</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.LockDriveMode">
                                @foreach (var t in DriveModes)
                                {
                                    <option value="@t.Key">@t.Value</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Release for (seconds)</label>
                            <input type="number" class="form-control" @bind="dDetail.RelayA_Time" />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <div class="col-lg-4">
                            <label class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="dDetail.RelayA_TZOverideEnable"></InputCheckbox>
                                <span class="form-check-label">Open during time zone</span>
                            </label>
                        </div>
                        <div class="col-lg-5">
                            <InputSelect class="form-select" @bind-Value="dDetail.RelayA_OpenTimeZone">
                                <option value=""></option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="dDetail.AutoRelockEnable"></InputCheckbox>
                            <span class="form-check-label">Auto-relock</span>
                        </label>
                    </div>
                </CardBody>
            </Card>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Relay B</CardTitle>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Mode</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.RelayB_Mode">
                                @foreach (var t in RelayBModes)
                                {
                                    <option value="@t.Key">@t.Value</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Release relay for (seconds)</label>
                            <input type="number" class="form-control" @bind="dDetail.RelayB_Time" />
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-lg-6">
                            <label class="form-label">Time zone</label>
                            <InputSelect class="form-select" @bind-Value="dDetail.RelayB_TimeZone">
                                <option value=""></option>
                            </InputSelect>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">Delay between relay A &amp; B (x 10ms)</label>
                            <input type="number" class="form-control" @bind="dDetail.RelayB_Delay" />
                        </div>
                    </div>
                </CardBody>
            </Card>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Failed to Close Door</CardTitle>
                    <div class="mb-3 row align-items-center">
                        <div class="col-lg-7">
                            <label class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="dDetail.PDO_AlarmEnable"></InputCheckbox>
                                <span class="form-check-label">Sound an alarm if the door is open for</span>
                            </label>
                        </div>
                        <div class="col-lg-3">
                            <span class="d-flex align-items-center gap-2">
                                <input type="number" class="form-control" @bind="dDetail.PDO_Alarm_Time" />
                                <span>seconds</span>
                            </span>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </Tab>

        @* ============================= STATUS ============================= *@
        <Tab Title="Status">
            @* Live hardware status decoded from the controller's last ping reply (B,2), fed by the
               app-wide DoorStatusStore — the same real-time source the floorplan and doors table use.
               Everything reads "Unknown" (blue) until the first reply arrives. *@
            @if (dDetail.Door != 0)
            {
                <div class="text-muted small mb-2 d-flex align-items-center gap-2">
                    <span class="badge @(DoorStatus.IsConnected ? "bg-green-lt" : "bg-secondary-lt")">
                        @(DoorStatus.IsConnected ? "Live" : "Connecting…")
                    </span>
                    @if (!IsOnline)
                    {
                        @* Controller out of contact: the indicators below read Unknown rather than stale. *@
                        <span class="badge bg-secondary-lt">Door offline</span>
                    }
                    @if (RawHw?.LastPolledUtc is DateTime polled)
                    {
                        <span>Last polled @polled.ToLocalTime().ToString("HH:mm:ss")</span>
                    }
                </div>
            }
            <div class="row">
                <div class="col-lg-6">
                    <Alert BackgroundColor="RelayColor(RelayAState)">
                        @* Title on its own row, buttons stacked on the next row. *@
                        <div>
                            <div class="alert-title mb-2">Relay A — @RelayLabel(RelayAState)</div>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary" disabled="@(!CanControl)"
                                        @onclick="() => SendRelayCommand(DoorCommandAction.Unlock, DoorRelay.RelayA)">Open</button>
                                <button type="button" class="btn btn-outline-secondary" disabled="@(!CanControl)"
                                        @onclick="() => SendRelayCommand(DoorCommandAction.Lock, DoorRelay.RelayA)">Close</button>
                                <button type="button" class="btn btn-outline-secondary" disabled="@(!CanControl)"
                                        @onclick="() => SendRelayCommand(DoorCommandAction.MomentaryRelease, DoorRelay.RelayA)">Release</button>
                            </div>
                        </div>
                    </Alert>
                </div>
                <div class="col-lg-6">
                    <Alert BackgroundColor="RelayColor(RelayBState)">
                        <div>
                            <div class="alert-title mb-2">Relay B — @RelayLabel(RelayBState)</div>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary" disabled="@(!CanControl)"
                                        @onclick="() => SendRelayCommand(DoorCommandAction.Unlock, DoorRelay.RelayB)">Open</button>
                                <button type="button" class="btn btn-outline-secondary" disabled="@(!CanControl)"
                                        @onclick="() => SendRelayCommand(DoorCommandAction.Lock, DoorRelay.RelayB)">Close</button>
                            </div>
                        </div>
                    </Alert>
                </div>
            </div>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Status</CardTitle>
                    @* gx-5 widens the gutter so the left column's indicator isn't crowding the right column's label. *@
                    <div class="row gx-5">
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Door Monitor</span>
                            @{ var doorMonitor = InputStatus(DoorMonitorBit); }
                            <Status BackgroundColor="doorMonitor.Color" DotType="StatusDotType.Normal">@doorMonitor.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Request to Exit</span>
                            @{ var rte = InputStatus(RqeBit); }
                            <Status BackgroundColor="rte.Color" DotType="StatusDotType.Normal">@rte.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Interlock Input</span>
                            @{ var interlock = InputStatus(InterlockBit); }
                            <Status BackgroundColor="interlock.Color" DotType="StatusDotType.Normal">@interlock.Label</Status>
                        </div>
                    </div>
                </CardBody>
            </Card>

            <Card Size="CardSize.Default">
                <CardBody>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <CardTitle class="mb-0">Alarms</CardTitle>
                        @* No controller alarm-reset command is exposed by the API yet, so this stays disabled. *@
                        <button type="button" class="btn btn-outline-secondary" disabled title="Alarm reset is not available yet">Reset</button>
                    </div>
                    <div class="row gx-5">
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Door Forced</span>
                            @{ var forced = AlarmStatus(DoorAlarmFlags.Forced); }
                            <Status BackgroundColor="forced.Color" DotType="StatusDotType.Normal">@forced.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Duress</span>
                            @{ var duress = AlarmStatus(DoorAlarmFlags.Duress); }
                            <Status BackgroundColor="duress.Color" DotType="StatusDotType.Normal">@duress.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Hacker</span>
                            @{ var hacker = AlarmStatus(DoorAlarmFlags.Hacker); }
                            <Status BackgroundColor="hacker.Color" DotType="StatusDotType.Normal">@hacker.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Fire</span>
                            @{ var fire = AlarmStatus(DoorAlarmFlags.Fire); }
                            <Status BackgroundColor="fire.Color" DotType="StatusDotType.Normal">@fire.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Intruder</span>
                            @{ var intruder = AlarmStatus(DoorAlarmFlags.Intruder); }
                            <Status BackgroundColor="intruder.Color" DotType="StatusDotType.Normal">@intruder.Label</Status>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-between mb-2">
                            <span>Door Failed to Close</span>
                            @{ var pdo = AlarmStatus(DoorAlarmFlags.Pdo); }
                            <Status BackgroundColor="pdo.Color" DotType="StatusDotType.Normal">@pdo.Label</Status>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </Tab>

        @* ============================= CONTROLLER ============================= *@
        <Tab Title="Controller">
            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Controller Administration</CardTitle>
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-secondary w-100">Clear Cards</button>
                        <small class="text-muted d-block text-center fst-italic">[All card information will be deleted from the controller]</small>
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-secondary w-100">Clear Events</button>
                        <small class="text-muted d-block text-center fst-italic">[All event information will be deleted from the controller]</small>
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-secondary w-100">Clear Time Zones, Calendars and Access Levels</button>
                        <small class="text-muted d-block text-center fst-italic">[All time zone and access level information will be deleted from the controller]</small>
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-secondary w-100">Set Date and Time</button>
                        <small class="text-muted d-block text-center fst-italic">[The date and time will automatically be corrected if 5 seconds different to the server time]</small>
                    </div>
                </CardBody>
            </Card>

            <Card Size="CardSize.Default">
                <CardBody>
                    <CardTitle>Biometric</CardTitle>
                    <div class="mb-3 row align-items-center">
                        <div class="col-lg-6">
                            <button type="button" class="btn btn-outline-secondary w-100">Clear Biometric data</button>
                        </div>
                        @* Target label + dropdown inline, aligned to the right of the row. *@
                        <div class="col-lg-6 d-flex align-items-center justify-content-end gap-2">
                            <label class="form-label mb-0">Target</label>
                            <InputSelect class="form-select" style="width: auto;" @bind-Value="biometricTarget">
                                <option value="Reader A">Reader A</option>
                                <option value="Reader B">Reader B</option>
                            </InputSelect>
                        </div>
                    </div>
                    <small class="text-muted d-block fst-italic mb-3">[All Biometric Templates and Aliases will be deleted from the controller]</small>
                    <div class="mb-3 row">
                        <div class="col-lg-3">
                            <button type="button" class="btn btn-outline-secondary w-100">Cancel</button>
                        </div>
                        <div class="col-lg-6">
                            <button type="button" class="btn btn-outline-secondary w-100">Send Biometric data</button>
                        </div>
                    </div>
                    <small class="text-muted d-block fst-italic">[Send all biometric templates to this controller]</small>
                </CardBody>
            </Card>
        </Tab>
    </Tabs>

<br />
@if (dDetail.LastUpdated != default)
{
    <label>Last Updated: @dDetail.LastUpdated </label>
}
<Button class="float-end" BackgroundColor="TablerColor.Primary" Type="ButtonType.Submit" Text="Submit"></Button>
</TablerForm>

@code {

    [Inject] TabBlazor.Services.TablerService TablerService { get; set; } = null!;
    [Inject] TabBlazor.Services.IModalService ModalService { get; set; } = null!;
    [Inject] IHttpClientFactory ClientFactory { get; set; } = null!;

    public DoorDetailDto dDetail { get; set; } = new DoorDetailDto();
    [Parameter] public int DoorId { get; set; }
    // The site a new door is created under (passed from the per-site Doors page; 0 = none).
    [Parameter] public int SiteId { get; set; }
    [CascadingParameter] public bool CascadingParameter { get; set; } = false;

    // ---- Local backing field for UI-only controls (not persisted) ----
    private string biometricTarget = "Reader A";

    // ---- Live status (Status tab) ----
    // Whether the current user may drive the relays (Site Settings write) — commands are gated on it.
    private bool canWrite;
    // True while a relay command is in flight, so the buttons disable to avoid double-fires.
    private bool busy;

    // Bit positions inside DoorHardwareStatusDto.Status1 (see DoorStatusDecoder):
    // bit2 = door-release monitor, bit3 = request-to-exit, bit5 = interlock input.
    private const int DoorMonitorBit = 2;
    private const int RqeBit = 3;
    private const int InterlockBit = 5;

    // Live state for this door from the app-wide store (null until the first ping reply arrives).
    private DoorStateDto? LiveState => dDetail.Door != 0 ? DoorStatus.TryGet(dDetail.Door) : null;

    // True while the controller is in recent contact. Offline = no recent reply, so whatever we last
    // decoded is now stale and must not be trusted.
    private bool IsOnline => LiveState is { Status: not DoorLiveStatus.Offline };

    // The last-decoded hardware snapshot, kept regardless of online state purely so we can still show
    // "Last polled …" (which explains why the indicators read Unknown while offline).
    private DoorHardwareStatusDto? RawHw => LiveState?.Hardware;

    // The hardware snapshot the indicators actually decode. Null when offline, so relays, inputs and
    // alarms fall back to Unknown (blue) instead of latching to the last-known state.
    private DoorHardwareStatusDto? Hw => IsOnline ? RawHw : null;
    private RelayState RelayAState => Hw?.RelayA ?? RelayState.Unknown;
    private RelayState RelayBState => Hw?.RelayB ?? RelayState.Unknown;

    // Relays can only be driven for a saved door the user is allowed to control, and not mid-command.
    private bool CanControl => canWrite && !busy && dDetail.Door != 0;

    private static bool Bit(byte b, int bit) => (b & (1 << bit)) != 0;

    private static TablerColor RelayColor(RelayState s) => s switch
    {
        RelayState.Open => TablerColor.Azure,
        RelayState.Closed => TablerColor.Green,
        _ => TablerColor.Blue
    };

    private static string RelayLabel(RelayState s) => s switch
    {
        RelayState.Open => "Released",
        RelayState.Closed => "Locked",
        _ => "Unknown"
    };

    // A raw Status1 input bit → indicator colour/label. Blue "Unknown" until a reply is decoded.
    private (TablerColor Color, string Label) InputStatus(int bit)
    {
        if (Hw is null) return (TablerColor.Blue, "Unknown");
        return Bit(Hw.Status1, bit) ? (TablerColor.Green, "Active") : (TablerColor.Secondary, "Inactive");
    }

    // An alarm flag → indicator colour/label. Blue "Unknown" until a reply is decoded.
    private (TablerColor Color, string Label) AlarmStatus(DoorAlarmFlags flag)
    {
        if (Hw is null) return (TablerColor.Blue, "Unknown");
        return Hw.Alarms.HasFlag(flag) ? (TablerColor.Danger, "Alarm") : (TablerColor.Green, "Clear");
    }

    private void OnStatusChanged() => InvokeAsync(StateHasChanged);

    private async Task SendRelayCommand(DoorCommandAction action, DoorRelay relay)
    {
        if (!CanControl) return;
        busy = true;
        try
        {
            var client = ClientFactory.CreateClient("WebAPI");
            await client.PostAsJsonAsync(
                $"api/DoorControl/{dDetail.Door}/command",
                new DoorCommandRequest { Action = action, Relay = relay });
        }
        catch
        {
            // Best-effort: the live feed will reflect the real relay state once the controller replies.
        }
        finally
        {
            busy = false;
        }
    }

