    private readonly Dictionary<byte, string> RelayBModes = new()
    {
        { 0, "Follow relay A" },
        { 1, "Independent" },
        { 2, "Time zone" },
    };

    protected override async Task OnInitializedAsync()
    {
        // Gate the Status-tab relay controls on the Site Settings write permission.
        var authState = await AuthState.GetAuthenticationStateAsync();
        canWrite = authState.User.CanWriteSiteSettings();

        if (DoorId != 0){
            var client = ClientFactory.CreateClient("WebAPI");
            var result = await client.GetFromJsonAsync<DoorDetailDto?>("api/Door/" + DoorId);
            if(result is not null)
            {
                dDetail = result;
            }
        }
        else if (SiteId > 0)
        {
            // New door: pin it to the site its "Add Door" button was launched under.
            dDetail.Site = SiteId;
        }

        // Subscribe to the app-wide live feed so the Status tab tracks the controller in real time,
        // and make sure it's running (idempotent — other components may already have started it).
        DoorStatus.Changed += OnStatusChanged;
        await DoorStatus.EnsureStartedAsync();
    }

    public void Dispose() => DoorStatus.Changed -= OnStatusChanged;

    private void Cancel()
    {
        ModalService.Close(ModalResult.Cancel());
    }

    private async Task Submit(EditContext obj)
    {
        if (DoorId == 0)
        {
            var client = ClientFactory.CreateClient("WebAPI");
            var result = await client.PostAsJsonAsync<DoorDetailDto>("api/Door/", dDetail);
            if (result.IsSuccessStatusCode) ModalService.Close(ModalResult.Ok());
            else
            {
                await ModalService.ShowDialogAsync(new TabBlazor.Components.Modals.DialogOptions
                {
                    MainText = result.StatusCode.ToString(),
                    SubText = await result.Content.ReadAsStringAsync(),
                    IconType = TablerIcons.Alert_triangle,
                    CancelText = "",
                    StatusColor = TablerColor.Danger
                });
            }
        }
        else
        {
            var client = ClientFactory.CreateClient("WebAPI");
            var result = await client.PutAsJsonAsync<DoorDetailDto>("api/Door/" + dDetail.Door, dDetail);
            if (result.IsSuccessStatusCode) ModalService.Close(ModalResult.Ok());
            else
            {
                await ModalService.ShowDialogAsync(new TabBlazor.Components.Modals.DialogOptions
                {
                    MainText = result.StatusCode.ToString(),
                    SubText = await result.Content.ReadAsStringAsync(),
                    IconType = TablerIcons.Alert_triangle,
                    CancelText = "",
                    StatusColor = TablerColor.Danger
                });
            }
        }
    }

